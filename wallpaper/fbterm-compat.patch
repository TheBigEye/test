--- a/src/lib/vterm.cpp
+++ b/src/lib/vterm.cpp
@@ -469,6 +469,31 @@
 
 void VTerm::do_control_char()
 {
+	/* Inside an OSC sequence (ESC ] ...), swallow every character
+	 * until a terminator arrives: BEL, CAN, SUB, or ST (ESC \).
+	 * The palette commands (ESC ] P... / ESC ] R) are the only OSC
+	 * sequences FbTerm implements; they are handed over to the
+	 * legacy ESnonstd state. Everything else (OSC 8 hyperlinks,
+	 * OSC 52 clipboard data, window titles, ...) is silently
+	 * dropped, as other terminals do with unknown OSC sequences. */
+	if (esc_state == ESosc) {
+		if (cur_char == 0x07 || cur_char == 0x18 || cur_char == 0x1A) {
+			esc_state = ESnormal;
+			return;
+		}
+		if (cur_char != 0x1B) {
+			if (osc_first) {
+				osc_first = false;
+				if (cur_char == 'P' || cur_char == 'R')
+					esc_state = ESnonstd;
+				else
+					return;
+			} else {
+				return;
+			}
+		}
+	}
+
 	u8 index = (cur_char < MAX_CONTROL_CODE ? control_map[cur_char] : 0);
 	const Sequence *seq = control_sequences + index;
 
