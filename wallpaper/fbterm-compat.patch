 }
 
+/* Map a 24-bit RGB colour onto the xterm 256-colour palette
+ * (6x6x6 colour cube; grey ramp for greys). FbTerm has no truecolor
+ * framebuffer mode, so SGR 38;2/48;2 colours are approximated. */
+static u8 rgb_to_256(u16 r, u16 g, u16 b)
+{
+	if (r > 255) r = 255;
+	if (g > 255) g = 255;
+	if (b > 255) b = 255;
+
+	if (r == g && g == b) {
+		if (r < 8) return 16;
+		if (r > 248) return 231;
+		return 232 + (r - 8) * 24 / 247;
+	}
+
+	return 16 + 36 * ((r * 5 + 127) / 255)
+		+ 6 * ((g * 5 + 127) / 255) + ((b * 5 + 127) / 255);
+}
+
 void VTerm::set_display_attr()
 {
 	for (u16 n = 0; n <= npar; n++) {
@@ -520,8 +545,21 @@
 			char_attr.fcolor = param[n] % 10;
 			break;
 		case 38:
-			char_attr.fcolor = cur_fcolor;
-			char_attr.underline = true;
+			if (n + 2 <= npar && param[n + 1] == 5) {
+				// SGR 38;5;<n>: 256-colour foreground
+				char_attr.fcolor = param[n + 2];
+				n += 2;
+			} else if (n + 4 <= npar && param[n + 1] == 2) {
+				// SGR 38;2;<r>;<g>;<b>: truecolor (approximated)
+				char_attr.fcolor = rgb_to_256(param[n + 2], param[n + 3], param[n + 4]);
+				n += 4;
+			} else if (n < npar && (param[n + 1] == 5 || param[n + 1] == 2)) {
+				// truncated extended colour sequence: ignore it
+				n = npar;
+			} else {
+				char_attr.fcolor = cur_fcolor;
+				char_attr.underline = true;
+			}
 			break;
 		case 39:
 			char_attr.fcolor = cur_fcolor;
@@ -530,9 +568,31 @@
 		case 40 ... 47:
 			char_attr.bcolor = param[n] % 10;
 			break;
+		case 48:
+			if (n + 2 <= npar && param[n + 1] == 5) {
+				// SGR 48;5;<n>: 256-colour background
+				char_attr.bcolor = param[n + 2];
+				n += 2;
+			} else if (n + 4 <= npar && param[n + 1] == 2) {
+				// SGR 48;2;<r>;<g>;<b>: truecolor (approximated)
+				char_attr.bcolor = rgb_to_256(param[n + 2], param[n + 3], param[n + 4]);
+				n += 4;
+			} else if (n < npar && (param[n + 1] == 5 || param[n + 1] == 2)) {
+				// truncated extended colour sequence: ignore it
+				n = npar;
+			}
+			break;
 		case 49:
 			char_attr.bcolor = cur_bcolor;
 			break;
+		case 90 ... 97:
+			// bright foreground colours
+			char_attr.fcolor = param[n] - 90 + 8;
+			break;
+		case 100 ... 107:
+			// bright background colours
+			char_attr.bcolor = param[n] - 100 + 8;
+			break;
 		default :
 			break;
 		}
